# crawled data (regenerated by the crawler)
/data/

# built binaries
/bin/

# frontend deps
web/node_modules/
web/dist/
web/.vite/

# logs & OS noise
*.log
.DS_Store

# local secrets (Google OAuth client id/secret, ...) — never committed;
# see cmd/server/main.go's loadDotEnv and .env.example for the expected keys
.env
.env.local

# NOTE: internal/webui/dist IS committed (the embedded, prebuilt frontend) so
# `go build` produces a working single-binary server without needing npm.

# embedded data snapshot (synced from ./data by `make binaries`)
internal/dataset/data/*
!internal/dataset/data/.gitkeep
